---
// Shared home page for en and fa: same layout, strings passed in.
import Base from './Base.astro';
import { person } from '../person.js';
const { t, lang, posts } = Astro.props;
const schema = { '@context': 'https://schema.org', '@graph': [
  person,
  { '@type': 'WebSite', '@id': 'https://rezanobakht.dev/#website', url: 'https://rezanobakht.dev/', name: 'Reza Nobakht', inLanguage: ['en', 'fa'], publisher: { '@id': person['@id'] } },
  { '@type': 'ProfilePage', url: new URL(Astro.url.pathname, Astro.site).href, inLanguage: lang, mainEntity: { '@id': person['@id'] } },
]};
---
<Base title={t.title} lang={lang} description={t.description} schema={schema}>
  <section class="hero rise">
    <img class="avatar" src="/reza.jpg" alt={t.name} width="112" height="112" />
    <p class="label">$ whoami<span class="cursor"></span></p>
    <h1>{t.name}</h1>
    <p class="role">{t.role}</p>
    <p class="lead">{t.lead}</p>
    <div class="cta">
      <a class="btn primary" href="#writing">{t.ctaWriting}</a>
      <a class="btn" href="/Reza_Nobakht_Resume.pdf">{t.ctaResume}</a>
      <a class="btn" href="https://www.linkedin.com/in/reza-nobakht">LinkedIn</a>
    </div>
  </section>

  <section class="stats">
    {t.stats.map((s, i) => (
      <div class="stat rise" style={`animation-delay:${120 + i * 70}ms`}>
        <span class="num" dir="ltr">{s[0]}</span><span class="muted">{s[1]}</span>
      </div>
    ))}
  </section>

  <section class="block">
    <p class="label">{t.doLabel}</p>
    <div class="cards">
      {t.cards.map(c => (
        <article class="card"><h3>{c[0]}</h3><p class="muted">{c[1]}</p></article>
      ))}
    </div>
  </section>

  <section class="block" id="writing">
    <p class="label">{t.writingLabel}</p>
    {posts.length ? (
      <ul class="posts">
        {posts.map(p => (
          <li><a href={`${p.url}/`}>
            <span class="t">{p.frontmatter.title}</span>
            <span class="d" dir="ltr">{p.frontmatter.date}</span>
          </a></li>
        ))}
      </ul>
    ) : <p class="muted">{t.empty}</p>}
  </section>
</Base>

<style>
  .hero { padding:24px 0 8px; }
  .avatar { display:block; width:112px; height:112px; border-radius:50%; object-fit:cover;
            border:2px solid var(--accent); margin-bottom:18px; }
  .cursor { display:inline-block; width:8px; height:15px; margin-inline-start:6px; vertical-align:-2px;
            background:var(--accent); animation:blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity:0; } }
  h1 { font-size:clamp(44px, 9vw, 76px); font-weight:800; margin:8px 0 6px;
       background:linear-gradient(100deg, var(--fg) 30%, var(--accent) 75%, var(--accent2));
       -webkit-background-clip:text; background-clip:text; color:transparent; }
  .role { font:15px var(--mono); color:var(--muted); margin:0 0 20px; }
  .lead { font-size:19px; max-width:640px; margin:0 0 28px; }
  .cta { display:flex; flex-wrap:wrap; gap:10px; }
  .btn { font:500 14px var(--mono); padding:10px 16px; border:1px solid var(--line); border-radius:10px;
         color:var(--fg); background:var(--panel); transition:border-color .2s, transform .2s; }
  .btn:hover { border-color:var(--accent); text-decoration:none; transform:translateY(-2px); }
  .btn.primary { background:var(--accent); border-color:var(--accent); color:var(--bg); font-weight:600; }
  .stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:12px; margin:56px 0; }
  .stat { display:flex; flex-direction:column; gap:4px; padding:18px; border:1px solid var(--line);
          border-radius:14px; background:var(--panel); font-size:14px; line-height:1.5; }
  .num { font:700 26px var(--mono); color:var(--fg); }
  .block { margin:56px 0; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-top:14px; }
  .card { padding:20px; border:1px solid var(--line); border-radius:14px; background:var(--panel);
          transition:border-color .2s, transform .2s; }
  .card:hover { border-color:color-mix(in srgb, var(--accent) 60%, var(--line)); transform:translateY(-3px); }
  .card h3 { margin:0 0 8px; font-size:18px; }
  .card p { margin:0; font-size:15px; line-height:1.65; }
  .posts { list-style:none; padding:0; margin:14px 0 0; border-top:1px solid var(--line); }
  .posts a { display:flex; justify-content:space-between; gap:16px; padding:16px 4px;
             border-bottom:1px solid var(--line); color:var(--fg); transition:padding .2s, color .2s; }
  .posts a:hover { text-decoration:none; color:var(--accent); padding-inline-start:12px; }
  .posts .d { font:13px var(--mono); color:var(--muted); white-space:nowrap; padding-top:3px; }
</style>
