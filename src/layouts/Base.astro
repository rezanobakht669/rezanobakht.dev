---
const { title, lang = 'en', description = '', schema = null, type = 'website', noindex = false } = Astro.props;
const fa = lang === 'fa';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// every page exists in both languages: / <-> /fa/, /en/x/ <-> /fa/x/
const enPath = fa ? (path === '/fa/' ? '/' : path.replace('/fa/', '/en/')) : path;
const faPath = fa ? path : (path === '/' ? '/fa/' : path.replace('/en/', '/fa/'));
const og = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang} dir={fa ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex" /> : <>
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="fa" href={new URL(faPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
  </>}
  <meta name="author" content="Reza Nobakht" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Reza Nobakht" />
  <meta property="og:locale" content={fa ? 'fa_IR' : 'en_US'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <link rel="sitemap" href="/sitemap.xml" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <meta name="theme-color" content="#0a0b0d" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230a0b0d'/><text x='16' y='22' font-family='monospace' font-size='16' font-weight='700' fill='%2334d399' text-anchor='middle'>RN</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=JetBrains+Mono:wght@400;600${fa ? '&family=Vazirmatn:wght@400;500;700;800' : ''}&display=swap`} />
  <style is:global>
    :root {
      --bg:#0a0b0d; --panel:#111317; --line:#1f232a; --fg:#e7e9ee; --muted:#8b93a1;
      --accent:#34d399; --accent2:#22d3ee; --glow:rgba(52,211,153,.14);
      --sans:Inter, system-ui, sans-serif; --mono:'JetBrains Mono', ui-monospace, monospace;
    }
    @media (prefers-color-scheme: light) {
      :root { --bg:#fafaf9; --panel:#fff; --line:#e7e5e4; --fg:#16181d; --muted:#5f6672;
              --accent:#059669; --accent2:#0891b2; --glow:rgba(5,150,105,.10); }
    }
    html[lang=fa] { --sans:Vazirmatn, system-ui, sans-serif; }
    * { box-sizing:border-box; }
    html { -webkit-text-size-adjust:100%; }
    body {
      margin:0; background:var(--bg); color:var(--fg); font:17px/1.75 var(--sans);
      background-image:
        radial-gradient(900px 500px at 85% -10%, var(--glow), transparent 60%),
        radial-gradient(color-mix(in srgb, var(--muted) 18%, transparent) 1px, transparent 1px);
      background-size:auto, 24px 24px; background-attachment:fixed;
    }
    .wrap { max-width:780px; margin:0 auto; padding:0 16px; }
    a { color:var(--accent); text-decoration:none; }
    a:hover { text-decoration:underline; text-underline-offset:3px; }
    ::selection { background:var(--accent); color:var(--bg); }
    header.top { position:sticky; top:0; z-index:5; backdrop-filter:blur(10px);
      background:color-mix(in srgb, var(--bg) 75%, transparent); border-bottom:1px solid var(--line); }
    header.top .wrap { display:flex; align-items:center; justify-content:space-between; height:56px; }
    .logo { font:600 15px var(--mono); color:var(--fg); }
    .logo b { color:var(--accent); }
    header nav { display:flex; gap:18px; font:14px var(--mono); }
    header nav a { color:var(--muted); }
    header nav a:hover { color:var(--fg); text-decoration:none; }
    main { padding:56px 0 40px; }
    h1,h2,h3 { line-height:1.2; letter-spacing:-.02em; }
    html[lang=fa] :is(h1,h2,h3) { letter-spacing:0; }
    html[lang=fa] :is(header nav, .label, .btn, .back, .role, footer) { font-family:var(--sans); }
    .label { font:13px var(--mono); color:var(--accent); letter-spacing:.04em; }
    .muted { color:var(--muted); }
    code { font:.88em var(--mono); background:var(--panel); border:1px solid var(--line); padding:1px 6px; border-radius:6px; }
    pre { direction:ltr; text-align:left; overflow-x:auto; background:var(--panel); border:1px solid var(--line);
          border-radius:12px; padding:16px 18px; font:14px/1.6 var(--mono); }
    pre code { background:none; border:0; padding:0; }
    footer { border-top:1px solid var(--line); padding:28px 0 48px; font:13px var(--mono); color:var(--muted); }
    footer .wrap { display:flex; flex-wrap:wrap; gap:12px 20px; justify-content:space-between; }
    footer nav { display:flex; flex-wrap:wrap; gap:16px; }
    footer a { color:var(--muted); } footer a:hover { color:var(--accent); }
    .rise { animation:rise .7s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes rise { from { opacity:0; transform:translateY(14px); } }
    @media (prefers-reduced-motion: reduce) { .rise { animation:none; } }
  </style>
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="logo" href={fa ? '/fa/' : '/'}><b>~/</b>rezanobakht</a>
      <nav>
        <a href={fa ? '/fa/#writing' : '/#writing'}>{fa ? 'نوشته‌ها' : 'writing'}</a>
        <a href="/Reza_Nobakht_Resume.pdf">{fa ? 'رزومه' : 'resume'}</a>
        <a href={fa ? '/' : '/fa/'} lang={fa ? 'en' : 'fa'}>{fa ? 'EN' : 'FA'}</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer>
    <div class="wrap">
      <span>© 2026 Reza Nobakht</span>
      <nav>
        <a href="https://www.linkedin.com/in/reza-nobakht">LinkedIn</a>
        <a href="https://github.com/rezanobakht669">GitHub</a>
        <a href="/Reza_Nobakht_Resume.pdf">Resume</a>
      </nav>
    </div>
  </footer>
</body>
</html>
