---
import Home from '../layouts/Home.astro';
const posts = Object.values(import.meta.glob('./en/*.md', { eager: true }))
  .sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
const t = {
  title: 'Reza Nobakht · CTO, Laravel backend & AI engineer',
  description: 'CTO and backend engineer. Laravel at scale, infrastructure, and LLM features in production.',
  name: 'Reza Nobakht',
  role: 'CTO · Backend & AI engineer · Laravel / PHP',
  lead: 'I run the engineering of a cross-border payments platform: architecture, infrastructure, and the team that ships it. Lately I put LLMs into production: tool-calling agents, AI ticket triage, LLM-as-judge evals.',
  ctaWriting: 'Read the writing', ctaResume: 'Resume (PDF)',
  stats: [
    ['5.6→13', 'Laravel upgrades, zero downtime'],
    ['96→99%', 'platform uptime'],
    ['8+ yrs', 'production Laravel / PHP'],
  ],
  doLabel: '// what I do',
  cards: [
    ['Payments backend', 'Money-moving systems in Laravel: transactions, consistency, integrations, and the boring correctness payments need.'],
    ['Infra & reliability', 'Active-passive failover, CI/CD, Cloudflare, monitoring. Keeping production up when the network is not.'],
    ['AI in production', 'Agents with tool calling, LLM triage, evals and AI code review in CI. Shipped, measured, not demos.'],
  ],
  writingLabel: '// writing',
  empty: 'First posts coming soon.',
};
---
<Home t={t} lang="en" posts={posts} />
